{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki"
    },
    {
      "name": "DS_PROM",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "ppchat usage",
  "uid": "ppchat-usage",
  "tags": ["ppchat", "lab"],
  "timezone": "browser",
  "editable": true,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Traffic (front nginx access log)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Requests (range)",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"ppchat-front\"} |~ \"\\\"(GET|POST) \" [$__range]))"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "WS handshakes (range)",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"ppchat-front\"} |~ \"GET /ws\" |~ \"\\\" 101 \" [$__range]))"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Logins (range)",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"ppchat-front\"} |~ \"POST /api/login\" |~ \"\\\" 200 \" [$__range]))"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Registrations (range)",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"ppchat-front\"} |~ \"POST /api/register\" |~ \"\\\" 20\" [$__range]))"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "5xx (range)",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"ppchat-front\"} | pattern `<_> - <_> [<_>] \"<method> <path> <_>\" <status> <_>` | status >= 500 [$__range]))"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "4xx (range)",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"ppchat-front\"} | pattern `<_> - <_> [<_>] \"<method> <path> <_>\" <status> <_>` | status >= 400 | status < 500 [$__range]))"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Requests by status class",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (count_over_time({service_name=\"ppchat-front\"} | pattern `<_> - <_> [<_>] \"<method> <path> <_>\" <status> <_>` | label_format class=`{{ printf \"%.1s\" .status }}xx` [$__auto]))",
          "legendFormat": "{{class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "1xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Activity: handshakes, logins, registrations",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"ppchat-front\"} |~ \"GET /ws\" |~ \"\\\" 101 \" [$__auto]))",
          "legendFormat": "ws handshakes"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({service_name=\"ppchat-front\"} |~ \"POST /api/login\" |~ \"\\\" 200 \" [$__auto]))",
          "legendFormat": "logins"
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({service_name=\"ppchat-front\"} |~ \"POST /api/register\" |~ \"\\\" 20\" [$__auto]))",
          "legendFormat": "registrations"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Backends",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Backend log volume (rough balancing proxy)",
      "description": "Both backends log at the same rate per request served, so sustained skew here means the django-pool round-robin is off.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (count_over_time({service_name=~\"ppchat-django|ppchat-django-legacy\"} [$__auto]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Backend + pushpin errors",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"ppchat-django|ppchat-django-legacy|ppchat-pushpin\"} |~ \"(?i)(error|traceback|critical|exception)\""
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    },
    {
      "type": "row",
      "title": "Box (shared with throwline)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "type": "timeseries",
      "title": "CPU (box-wide)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{instance=\"throwline\", mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "cpu busy"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1, "min": 0 },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Memory (box-wide)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (node_memory_MemAvailable_bytes{instance=\"throwline\"} / node_memory_MemTotal_bytes{instance=\"throwline\"})",
          "legendFormat": "memory used"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1, "min": 0 },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
