# Copy to .env.infra (git-ignored) and fill in. Source it before any
# kamal or tofu command: set -a; . ./.env.infra; set +a
# (the ahoy deploy tasks do this for you)

# the throwline Hetzner box
WEB_SERVER_IP=178.156.153.244

# ghcr.io personal access token with write:packages
KAMAL_REGISTRY_PASSWORD=

# fresh production values (e.g. openssl rand -hex 32)
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# corvus.observer Origin CA pair, from the MOVE platform tofu root:
#   cd ~/DEV/MOVE/platform/infra
#   tofu output -raw origin_certificate_pem
#   tofu output -raw origin_private_key_pem
# quote the multi-line PEMs:
#   CLOUDFLARE_ORIGIN_CERT_PEM='<full certificate PEM block>'
#   CLOUDFLARE_ORIGIN_KEY_PEM='<full private key PEM block>'
CLOUDFLARE_ORIGIN_CERT_PEM=
CLOUDFLARE_ORIGIN_KEY_PEM=

# for infra/ (the ppchat DNS record in MOVE's Cloudflare zone); same
# token and zone id MOVE's tofu root uses
CLOUDFLARE_API_TOKEN=
TF_VAR_cloudflare_zone_id=
